import "../types/connect-session.kscript"
import operations from "../lib/connect-v1.kscript"

/// Get the host's running and reachable flags.
/// @public
fn status(session: ConnectSession) => $session->request($operations.status)

/// List the spaces available to this app.
/// @public
fn list_spaces(session: ConnectSession) =>
  $session->request($operations.list_spaces)

/// Look up an app space by its id.
/// @public
fn get_space(session: ConnectSession, space: string) =>
  $session->request($operations.get_space, { space: $space })

/// Open the app space with this stable key, creating it on first use.
/// @public
fn open_space(session: ConnectSession, key: string, name: string) =>
  $session->request($operations.open_space, { key: $key, name: $name })

/// List all records in a space, or only those of the given type.
/// @public
fn list_records(session: ConnectSession, space: string, type: string? = null) {
  params = { space: $space }
  if $type != null {
    params.type = $type
  }
  return $session->request($operations.list_records, $params)
}

/// Fetch a record by id. A missing record returns null.
/// @public
fn get_record(session: ConnectSession, space: string, id: string) =>
  $session->request($operations.get_record, { space: $space, id: $id })

/// Apply field edits to a record and return the updated record.
/// @public
fn edit_record(
  session: ConnectSession,
  space: string,
  type: string,
  id: string,
  edits: list
) =>
  $session->request(
    $operations.edit_record,
    { space: $space, type: $type, id: $id, edits: $edits }
  )

/// Delete a record by id.
/// @public
fn delete_record(session: ConnectSession, space: string, id: string) =>
  $session->request($operations.delete_record, { space: $space, id: $id })

/// Build an edit that sets a numbered field to a value.
/// @public
fn set_value(field: int(min: 1, max: 65535), value: any) => {
  op: 'setValue',
  field: $field,
  value: $value
}

/// Build an edit that increases a numbered counter.
/// @public
fn add_to_counter(field: int(min: 1, max: 65535), by: int(min: 1)) => {
  op: 'addToCounter',
  field: $field,
  by: $by
}

/// Build an edit that adds items to a numbered set field.
/// @public
fn add_to_set(field: int(min: 1, max: 65535), items: list) => {
  op: 'addToSet',
  field: $field,
  items: $items
}

/// Build an edit that removes items from a numbered set field.
/// @public
fn remove_from_set(field: int(min: 1, max: 65535), items: list) => {
  op: 'removeFromSet',
  field: $field,
  items: $items
}
