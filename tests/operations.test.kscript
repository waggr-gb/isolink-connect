import "../libraries/isolink-connect/client.kscript" as sdk
import "../libraries/isolink-connect/src/protocol.kscript" as protocol
import "../libraries/isolink-connect/index.kscript" as legacy
import "scripted-connection.kscript"

fn update(session: any) {
  @sdk.list_records($session, 'home')
  @sdk.list_records($session, 'home', type: 'note')
  edits = [
    @sdk.set_value(field: 1, value: 'Coffee'),
    @sdk.add_to_counter(2, by: 3),
    @sdk.add_to_set(3, items: ['hot']),
    @sdk.remove_from_set(3, ['empty'])
  ]
  return @sdk.edit_record(
    $session,
    'home',
    type: 'note',
    id: 'shopping',
    edits: $edits
  )
}

describe(name: "Records") {
  test(name: "builds numbered edit operations and omits an absent record filter") {
    peer = ScriptedConnection(replies: [{
      id: 1,
      r: { protocol: 1, mode: 'host', me: {} }
    },
      { id: 2, r: [] }, { id: 3, r: [] }, { id: 4, r: { id: 'shopping' } }])
    result = @protocol.with_connection(
      $peer,
      'example.kscript',
      'Tests',
      @update
    )
    expect(value: $result.id, equals: 'shopping')
    expect(value: $peer.sent[1].p, equals: { space: 'home' })
    expect(value: $peer.sent[2].p, equals: { space: 'home', type: 'note' })
    expect(value: $peer.sent[3], equals: { id: 4, m: 'records.edit', p: { space: 'home', type: 'note', id: 'shopping', edits: [
      { op: 'setValue', field: 1, value: 'Coffee' },
      { op: 'addToCounter', field: 2, by: 3 },
      { op: 'addToSet', field: 3, items: ['hot'] },
      { op: 'removeFromSet', field: 3, items: ['empty'] }
    ] } })
  }

  test(name: "both entries accept existing named edit arguments") {
    expect(
      value: @legacy.set_value(value: 'Coffee', field: 1),
      equals: @sdk.set_value(1, 'Coffee')
    )
    expect(
      value: @legacy.add_to_counter(by: 3, field: 2),
      equals: @sdk.add_to_counter(2, 3)
    )
  }
}
